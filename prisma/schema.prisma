generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OPERATORE
  SOCCORRITORE
  ISPETTORE
}

model AppUser {
  id           Int    @id @default(autoincrement())
  username     String @unique
  fullName     String @map("full_name")
  passwordHash String @map("password_hash")
  role         Role

  submissions ChecklistSubmission[]
  inspections Inspection[]

  @@map("app_user")
}

model Vehicle {
  id    Int    @id @default(autoincrement())
  plate String @unique

  submissions ChecklistSubmission[]

  @@map("vehicle")
}

model ChecklistItem {
  id          Int    @id @default(autoincrement())
  description String

  @@map("checklist_item")
}

model ChecklistSubmission {
  id          Int      @id @default(autoincrement())
  vehicleId   Int      @map("vehicle_id")
  userId      Int      @map("user_id")
  confirmedAt DateTime @default(now()) @map("confirmed_at")

  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  user       AppUser     @relation(fields: [userId], references: [id], onDelete: Restrict)
  inspection Inspection?

  @@index([vehicleId])
  @@index([userId])
  @@map("checklist_submission")
}

model Inspection {
  id           Int      @id @default(autoincrement())
  submissionId Int      @unique @map("submission_id")
  inspectorId  Int      @map("inspector_id")
  isCorrect    Boolean  @map("is_correct")
  inspectedAt  DateTime @default(now()) @map("inspected_at")

  submission ChecklistSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  inspector  AppUser             @relation(fields: [inspectorId], references: [id], onDelete: Restrict)

  @@index([inspectorId])
  @@map("inspection")
}
